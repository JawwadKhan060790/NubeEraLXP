<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>NubeEra.Seeder</RootNamespace>
    <AssemblyName>NubeEra.Seeder</AssemblyName>
  </PropertyGroup>

  <!-- Shared domain / EF infrastructure (schema migration reuse) -->
  <ItemGroup>
    <ProjectReference Include="..\NubeEra.Infrastructure\NubeEra.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Direct MySQL driver for raw bulk INSERT operations -->
  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

</Project>
