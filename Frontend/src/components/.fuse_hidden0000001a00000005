// ─── Component ────────────────────────────────────────────────────────────────
const StatsCard: React.FC<StatsCardProps> = ({
  title,
  value,
  icon,
  color,
  colorClass,
  subtitle,
  trend,
  loading = false,
}) => {
  const key = resolveColor(color, colorClass);
  const c = colorConfig[key];

  const numericTarget = typeof value === 'number' ? value : 0;
  const animated = useCountUp(numericTarget);
  const displayValue = typeof value === 'number'
    ? animated.toLocaleString()
    : value;

  if (loading) return <SkeletonStatCard />;

  return (
    <div
      className={`
        relative overflow-hidden
        bg-gradient-to-br ${c.cardGradient}
        border border-slate-100/80
        rounded-2xl p-5
        shadow-[0_2px_12px_rgba(15,30,60,0.07)]
        ${c.hoverGlow} hover:-translate-y-0.5
        transition-all duration-300
        cursor-default group
      `}
    >
      {/* Decorative background orb */}
      <div className={`absolute -top-4 -right-4 w-24 h-24 rounded-full ${c.orb} blur-2xl pointer-events-none`} />

      <div className="relative flex items-start justify-between gap-3">

        {/* Left: label + value + trend */}
        <div className="flex flex-col min-w-0 space-y-1.5">
          <span className={`text-[10.5px] font-bold tracking-widest uppercase leading-none truncate ${c.labelColor}`}>
            {title}
          </span>

          <span className={`text-[30px] font-black leading-none tracking-tight text-slate-900 ${c.valueShadow}`}>
            {displayValue}
          </span>

          {trend ? (
            <div className="flex items-center gap-1.5 pt-0.5">
              <span className={`inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded-full text-[9px] font-black ${
                trend.value >= 0
                  ? 'bg-emerald-50 text-emerald-700'
                  : 'bg-rose-50 text-rose-600'
              }`}>
                {trend.value >= 0 ? <TrendingUp className="w-2.5 h-2.5" /> : <TrendingDown className="w-2.5 h-2.5" />}
                {trend.value >= 0 ? '+' : ''}{trend.value}%
              </span>
              <span className="text-[9.5px] text-slate-400 font-medium truncate">{trend.label}</span>
            </div>
          ) : subtitle ? (
            <span className="text-[10px] text-slate-400 font-semibold truncate pt-0.5">{subtitle}</span>
          ) : null}
        </div>

        {/* Right: icon */}
        {icon && (
          <div className={`
            w-12 h-12 rounded-2xl flex items-center justify-center shrink-0
            ${c.iconBg} ${c.iconText} ${c.iconGlow}
            transition-all duration-300 group-hover:scale-110 group-hover:rotate-3
          `}>
            {icon}
          </div>
        )}

      </div>
    </div>
  );
};

